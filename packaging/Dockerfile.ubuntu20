ARG UBUNTU20_IMAGE=python:3.10-slim-bullseye
FROM ${UBUNTU20_IMAGE} AS builder

ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN sed -i \
        -e "s|https\?://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
        -e "s|https\?://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
        -e "s|https\?://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
        /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        squashfs-tools \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libfontconfig1 \
        libdbus-1-3 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        file \
        libopengl0 \
        libgtk-3-0 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-shape0 \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG APPIMAGETOOL_SHA256=a6d71e2b6cd66f8e8d16c37ad164658985e0cf5fcaa950c90a482890cb9d13e0
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /src
COPY requirements.txt requirements-build.txt ./

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-build.txt

COPY . .

RUN QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -v

RUN if [ ! -x /src/appimagetool ]; then \
        curl -L --fail --retry 3 \
            -o /src/appimagetool \
            https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage; \
    fi \
    && echo "${APPIMAGETOOL_SHA256}  /src/appimagetool" | sha256sum --check \
    && chmod +x /src/appimagetool

RUN PYTHON_BIN=/usr/local/bin/python \
    APPIMAGETOOL=/src/appimagetool \
    ./packaging/build_appimage.sh

RUN status=0; \
    timeout 10 env \
        APPIMAGE_EXTRACT_AND_RUN=1 \
        QT_QPA_PLATFORM=offscreen \
        /src/release/Escope.AppImage || status=$?; \
    test "$status" -eq 124

FROM scratch AS artifact
COPY --from=builder /src/release/Escope.AppImage /Escope-Ubuntu20-x86_64.AppImage
